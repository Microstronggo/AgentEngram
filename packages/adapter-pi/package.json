{
  "name": "@agentengram/adapter-pi",
  "version": "0.1.0",
  "description": "Pi adapter for the AgentEngram context and memory runtime",
  "keywords": ["agent", "memory", "pi-mono", "context"],
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Microstronggo/AgentEngram.git", "directory": "packages/adapter-pi" },
  "homepage": "https://github.com/Microstronggo/AgentEngram/tree/main/packages/adapter-pi#readme",
  "bugs": { "url": "https://github.com/Microstronggo/AgentEngram/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentengram/engine": "workspace:*",
    "typebox": "1.3.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src test",
    "test:coverage": "vitest run src test/system --coverage.enabled --coverage.provider=v8 --coverage.thresholds.lines=70 --coverage.thresholds.functions=70 --coverage.thresholds.statements=70 --coverage.thresholds.branches=60"
  }
}
