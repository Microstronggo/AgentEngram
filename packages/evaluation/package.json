{
  "name": "@agentengram/evaluation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentengram-eval-locomo": "./dist/locomo/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@agentengram/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src test",
    "locomo": "node dist/locomo/cli.js"
  }
}
