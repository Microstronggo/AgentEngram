{
  "name": "@agentengram/engine",
  "version": "0.1.0",
  "description": "Framework-neutral context and memory runtime for AI agents",
  "keywords": ["agent", "memory", "context", "transcript", "mcp"],
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Microstronggo/AgentEngram.git", "directory": "packages/engine" },
  "homepage": "https://github.com/Microstronggo/AgentEngram/tree/main/packages/engine#readme",
  "bugs": { "url": "https://github.com/Microstronggo/AgentEngram/issues" },
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentengram": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js"
    },
    "./adapter": {
      "types": "./dist/adapter-api.d.ts",
      "import": "./dist/adapter-api.js"
    },
    "./testing": {
      "types": "./dist/testing-api.d.ts",
      "import": "./dist/testing-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage.enabled --coverage.provider=v8 --coverage.thresholds.lines=70 --coverage.thresholds.functions=70 --coverage.thresholds.statements=70 --coverage.thresholds.branches=60"
  }
}
