{
  "name": "@agentengram/adapter-codex",
  "version": "0.1.0",
  "description": "Codex Hook and MCP adapter for the AgentEngram runtime",
  "keywords": ["agent", "memory", "codex", "hooks", "mcp"],
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Microstronggo/AgentEngram.git", "directory": "packages/adapter-codex" },
  "homepage": "https://github.com/Microstronggo/AgentEngram/tree/main/packages/adapter-codex#readme",
  "bugs": { "url": "https://github.com/Microstronggo/AgentEngram/issues" },
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentengram-codex-hook": "./dist/cli.js",
    "agentengram-codex-mcp": "./dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "hooks",
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@agentengram/engine": "workspace:*",
    "@agentengram/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src test",
    "test:coverage": "vitest run src test --coverage.enabled --coverage.provider=v8 --coverage.thresholds.lines=70 --coverage.thresholds.functions=70 --coverage.thresholds.statements=70 --coverage.thresholds.branches=60"
  }
}
